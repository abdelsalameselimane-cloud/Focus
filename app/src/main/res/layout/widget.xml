<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF" android:textSize="26sp" android:textStyle="bold" android:text="--"/>
    <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#CCFFFFFF" android:textSize="12sp"/>
    <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="#FFFFFFFF" android:textSize="13sp"/>
</LinearLayout>
